/* style.css updates */

/* 1. Ensure the overall text is light by default */
#output-stream p {
    color: #e0e0e0; /* Default light gray/white */
    margin: 5px 0;
    line-height: 1.4;
}

/* 2. Style USER input (Your commands) stark white */
.user-command {
    color: #ffffff !important; /* Force pure white */
    font-weight: bold;
}

/* 3. Style AI output (The unconstrained core) dark crimson red */
.ai-response {
    color: #b30000 !important; /* Professional, deep dark red */
}

/* 4. Update the input prompt and text area colors to match your theme */
.input-area {
    display: flex;
    background-color: #1a1a1a;
    padding: 10px;
    border: 1px solid #00e6ff88; /* Keeping the cyan accent border */
    margin-top: 10px;
}

.prompt {
    color: #00e6ff; /* Cyan prompt */
    margin-right: 10px;
}

#user-input {
    flex: 1;
    background: transparent;
    border: none;
    color: #ffffff; /* Text you type is white */
    font-family: inherit;
    font-size: 1.1em;
}
input:focus { outline: none; }
